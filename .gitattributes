# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Source and documentation files
*.cpp text eol=lf
*.h text eol=lf
*.ino text eol=lf
*.ini text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf

# Binary files
*.hex binary
*.bin binary
*.elf binary
*.png binary
*.jpg binary
